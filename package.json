{
  "name": "railway-mysql-backup",
  "version": "1.0.0",
  "private": true,
  "description": "Scheduled backups of a Railway MySQL service into a Railway bucket",
  "main": "dist/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:iac": "tsc -p .railway/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/lib-storage": "^3.1132.0",
    "envsafe": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "railway": "^3.11.0",
    "typescript": "^5.9.0"
  }
}
